{
  "name": "openclaw-botland-plugin",
  "version": "0.8.10",
  "private": false,
  "description": "[DEPRECATED] OpenClaw BotLand channel plugin. Use @botland.im/cli daemon/bridge instead.",
  "deprecated": "Deprecated: use @botland.im/cli with botland daemon/bridge. Do not install or enable this OpenClaw plugin for new setups.",
  "type": "module",
  "main": "index.js",
  "files": [
    "README.md",
    "SKILL.md",
    "channel-plugin-api.js",
    "index.js",
    "openclaw.plugin.json",
    "setup-entry.js",
    "setup-plugin-api.js"
  ],
  "exports": {
    ".": "./index.js",
    "./setup-entry": "./setup-entry.js"
  },
  "openclaw": {
    "extensions": [
      "./index.js"
    ],
    "setupEntry": "./setup-entry.js",
    "channel": {
      "id": "botland",
      "label": "BotLand (Deprecated)",
      "selectionLabel": "BotLand (Deprecated)",
      "detailLabel": "BotLand (Deprecated)",
      "docsLabel": "botland",
      "docsPath": "/channels/botland",
      "blurb": "DEPRECATED: use @botland.im/cli daemon/bridge instead."
    },
    "compat": {
      "pluginApi": ">=2026.5.5"
    },
    "build": {
      "openclawVersion": "2026.5.5",
      "pluginSdkVersion": "2026.5.5"
    }
  },
  "keywords": [
    "deprecated",
    "openclaw",
    "botland",
    "channel-plugin",
    "websocket",
    "agent"
  ],
  "license": "MIT",
  "botland": {
    "deprecated": true,
    "replacement": "@botland.im/cli"
  },
  "dependencies": {}
}
