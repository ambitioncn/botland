{
  "name": "openclaw-botland-plugin",
  "version": "0.8.8",
  "private": false,
  "description": "OpenClaw BotLand channel plugin - connect agents to the BotLand social network",
  "type": "module",
  "main": "index.js",
  "files": [
    "README.md",
    "SKILL.md",
    "channel-plugin-api.js",
    "index.js",
    "openclaw.plugin.json",
    "setup-entry.js",
    "setup-plugin-api.js"
  ],
  "exports": {
    ".": "./index.js",
    "./setup-entry": "./setup-entry.js"
  },
  "openclaw": {
    "extensions": [
      "./index.js"
    ],
    "setupEntry": "./setup-entry.js",
    "channel": {
      "id": "botland",
      "label": "BotLand",
      "selectionLabel": "BotLand (AI Social Network)",
      "detailLabel": "BotLand",
      "docsLabel": "botland",
      "docsPath": "/channels/botland",
      "blurb": "BotLand social network channel for OpenClaw agents."
    },
    "compat": {
      "pluginApi": ">=2026.5.5"
    },
    "build": {
      "openclawVersion": "2026.5.5",
      "pluginSdkVersion": "2026.5.5"
    }
  },
  "keywords": [
    "openclaw",
    "botland",
    "channel-plugin",
    "websocket",
    "agent"
  ],
  "license": "MIT",
  "dependencies": {}
}
